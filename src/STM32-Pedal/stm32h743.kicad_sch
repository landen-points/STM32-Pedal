	(text "VDDA"
		(exclude_from_sim no)
		(at 276.098 46.482 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "136fa7d8-f1cb-4a0a-adcf-db9eacfb5f11")
	)
	(text "Disable VREFBUF in firmware\nBOOT_ADD1 = 0x1FF0 <- this may depend on bootloader version\n(might need external clock)\n\nSAI1 block A: slave transmitter, async. Recieve ext clock through PE5/PE4\nand transmit through PE6\n\nSAI1 block B: slave reciever, internal sync to block A, recieves through PE3\nShares block A clocks internally\n\nAudio format: I2S, stereo, 24-bit samples in two 32-bit slots\n\nI2C1: PB8/9, initially 100kHz. codec has addr 0x10\n\nPG0: push-pull output, initially low to hold codec in reset"
		(exclude_from_sim no)
		(at 91.44 22.352 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "21707040-793b-433b-a610-ecb1cadd2694")
	)
	(text "Programming Backup"
		(exclude_from_sim no)
		(at 32.766 115.824 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4838c4aa-7e0a-4854-98ca-7d56ede05c16")
	)
	(text "HSE CRYSTAL ?"
		(exclude_from_sim no)
		(at 159.258 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5d7c23fd-ef3e-4a5b-958b-79c707833352")
	)
	(text "PROGRAMMING:\n1. Power board from 9V, connect USB-C\n2. Close JP2 to pull BOOT0 high\n3. Press and release RESET\n4. STM32CubeProgrammer: choose USB, refresh and connect, program\n5. Open JP2 and RESET again"
		(exclude_from_sim no)
		(at 17.78 22.352 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "698b046c-3cab-4bef-b359-ca7b742ac86f")
	)
